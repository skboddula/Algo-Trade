# Cloudflare Worker local dev secrets — copy to .dev.vars and fill in values.
# .dev.vars is gitignored; this file is safe to commit.
#
# For production, set these via:
#   wrangler secret put UPSTOX_API_KEY
#   wrangler secret put UPSTOX_API_SECRET
#
# ─── Upstox OAuth ───────────────────────────────────────────────
# Obtained from https://account.upstox.com/developer/apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Redirect URI registered in your Upstox developer app.
# Local dev  → http://localhost:5173/broker/callback
# Production → https://<your-domain>/broker/callback
UPSTOX_REDIRECT_URI=http://localhost:5173/broker/callback

# ─── Auth0 Configurations (Required) ────────────────────────────
# Public identifiers, not secrets. The Worker rejects authenticated routes
# when either value is missing.
AUTH0_DOMAIN=algo-trade.us.auth0.com
AUTH0_AUDIENCE=https://algo-trade.us.auth0.com/api/v2/

# ─── Telegram Trade Alerts (Optional) ───────────────────────────
# Create a bot via @BotFather on Telegram, send it any message, then read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# For production, set these via:
#   wrangler secret put TELEGRAM_BOT_TOKEN
#   wrangler secret put TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
