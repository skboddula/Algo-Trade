# Environment Configuration for Algo-Trade Fastify Daemon

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Binding
PORT=3000
HOST=0.0.0.0

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# Master Market Polling Interval (Milliseconds)
POLLING_INTERVAL_MS=2000

# Upstox API Endpoint Base URL
UPSTOX_API_URL=https://api.upstox.com/v2

# Master Upstox Access Token (Used for single 1-API market data ingestion)
PRIMARY_UPSTOX_TOKEN=

# ─── Telegram Trade Alerts (Optional) ──────────────────────────────────────
# Create a bot via @BotFather on Telegram, send it any message, then read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# When configured, the daemon sends entry, exit, VIX warning, and daily
# summary alerts directly to your Telegram chat (no browser needed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=