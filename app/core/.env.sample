# Environment Configuration for Algo-Trade Fastify Daemon

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Binding
# Keep 127.0.0.1 on a personal machine (loopback only).
# Use 0.0.0.0 ONLY behind a firewall / reverse proxy or an authenticated tailnet.
PORT=3000
HOST=127.0.0.1

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# Master Market Polling Interval (Milliseconds)
POLLING_INTERVAL_MS=2000

# Upstox API Endpoint Base URL
UPSTOX_API_URL=https://api.upstox.com/v2

# Durable state directory (SQLite). Relative paths resolve against app/core.
# Survives daemon restarts and machine reboots. Back up algo-trade.sqlite from here.
DATA_DIR=./data

# Run entirely on synthetic data (no Upstox calls). Useful for testing the daemon.
# Set to true to smoke-test without a token.
# MOCK_MODE=false

# Master Upstox Access Token (Used for single 1-API market data ingestion)
# Expires daily (~03:30 IST). Refresh with scripts/refresh-token.sh
PRIMARY_UPSTOX_TOKEN=

# Live market-data transport (ignored in MOCK_MODE):
#   rest = REST LTP polling (default)
#   ws   = Upstox Market Data Feed V3 WebSocket: live index ticks + 1-minute
#          candles, with an option-chain refresh over REST every 15s during
#          market hours. A watchdog reports a silent/dropped feed as feed-down.
# MARKET_FEED_SOURCE=rest

# Optional Telegram alerts. Leave blank to disable all notifications.
# Sent: daemon started/stopping, market feed down/recovered, trades opened/closed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
