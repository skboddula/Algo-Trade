# Environment Configuration for Algo-Trade Fastify Daemon

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Binding
PORT=3000
HOST=0.0.0.0

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# Master Market Polling Interval (Milliseconds)
POLLING_INTERVAL_MS=2000

# Upstox API Endpoint Base URL
UPSTOX_API_URL=https://api.upstox.com/v2

# Master Upstox Access Token (Used for single 1-API market data ingestion)
PRIMARY_UPSTOX_TOKEN=