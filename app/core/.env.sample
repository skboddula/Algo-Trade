# Environment Configuration for Algo-Trade Fastify Daemon

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Binding
# Keep 127.0.0.1 on a personal machine (loopback only).
# Use 0.0.0.0 ONLY behind a firewall / reverse proxy or an authenticated tailnet.
PORT=3000
HOST=127.0.0.1

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# Master Market Polling Interval (Milliseconds)
POLLING_INTERVAL_MS=2000

# Upstox API Endpoint Base URL
UPSTOX_API_URL=https://api.upstox.com/v2

# Durable state directory (SQLite). Relative paths resolve against app/core.
# Survives daemon restarts and machine reboots. Back up algo-trade.sqlite from here.
DATA_DIR=./data

# Dashboard window (optional). The daemon serves the built React UI at http://HOST:PORT/
# when a bundle is present — build it with: yarn --cwd app/client build:daemon
# (deploy/install.sh does this automatically; SKIP_DASHBOARD=1 skips it).
# Auto-detected from the repo layout; override only for custom locations.
# DASHBOARD_DIR=/absolute/path/to/app/client/dist

# Extra browser origins allowed to call the API (comma-separated).
# Loopback origins (127.0.0.1 / localhost / ::1) are always allowed; CLI tools
# (scripts/bot.sh, curl) send no Origin header and always pass.
# ALLOWED_ORIGINS=https://dash.example

# Run entirely on synthetic data (no Upstox calls). Useful for testing the daemon.
# Set to true to smoke-test without a token.
# MOCK_MODE=false

# Master Upstox Access Token (Used for single 1-API market data ingestion)
# Expires daily (~03:30 IST). Refresh with scripts/refresh-token.sh
PRIMARY_UPSTOX_TOKEN=

# Upstox OAuth — refresh the daily token from the browser (recommended).
# One-time setup:
#   1. https://account.upstox.com/developer/apps → your app → add the redirect
#      URI below to its allowed Redirect URLs.
#   2. Fill UPSTOX_API_KEY + UPSTOX_API_SECRET (the app's API key/secret).
# Daily refresh: open http://127.0.0.1:3000/auth/upstox/start and log in.
# The API secret is only ever sent from this machine to Upstox.
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=http://127.0.0.1:3000/auth/upstox/callback

# Live market-data transport (ignored in MOCK_MODE):
#   rest = REST LTP polling (default)
#   ws   = Upstox Market Data Feed V3 WebSocket: live index ticks + 1-minute
#          candles, with an option-chain refresh over REST every 15s during
#          market hours. Open-position contracts and the nearest-strike
#          window stream at tick level. A watchdog reports a silent/dropped
#          feed as feed-down.
# MARKET_FEED_SOURCE=rest

# Live VRD sentiment ingestion (breadth/FII/PCR/max-pain/GIFT/news + India
# VIX). Default on. Set to false only for isolated staging — live entries are
# then fail-closed (blocked) while paper keeps staging on the fallback.
# DAEMON_USE_REAL_VRD=true

# WS-mode tuning (ignored with the `rest` transport; 0 disables the feature):
#   Option-chain REST refresh cadence in milliseconds (default 15000)
# OPTION_CHAIN_REFRESH_MS=15000
#   Nearest strikes per symbol streamed at tick level around spot (default 5)
# ATM_WINDOW_STRIKES=5

# Optional Telegram alerts. Leave blank to disable all notifications.
# Sent: daemon started/stopping, market feed down/recovered, trades opened/closed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
