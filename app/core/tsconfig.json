{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/server.ts",
    "src/types.ts",
    "src/constants.ts",
    "src/services/**/*",
    "src/routes/**/*",
    "src/__tests__/**/*",
    "../../packages/shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/brokers/**/*",
    "src/previous/**/*",
    "src/utils/**/*",
    "src/shared/**/*",
    "src/config/**/*",
    "src/cron.ts",
    "src/index.ts",
    "src/state.ts"
  ]
}
